        "complexity": result.get("complexity"),
        "strategy": result.get("strategy"),
        "reason": result.get("selection_reason"),
        "time_info": result.get("time_info"),
        "alternatives": result.get("alternatives"),
    }, ensure_ascii=False, indent=2)


