def _get_prompt_scale_hint(complexity: int, task_type: str) -> str:
    """Prompt 自适应缩放 (v2.3, 参考 OpenSquilla SquillaRouter)。

    根据任务复杂度返回提示缩放建议:
    - complexity 1-2: minimal — 简短回复，省 token
    - complexity 3: standard — 默认行为
    - complexity 4-5: full — 完整推理，详细输出
    """
    if complexity <= 2:
        return "minimal（简短回复，省略详细解释）"
    elif complexity >= 4:
        return "full（完整推理，详细分析）"
    return ""  # complexity 3: 不缩放，使用默认


def _store_result_to_plugin_context(session_id: str, result: dict) -> None:
    """将路由结果写入 PluginOrchestrator 共享上下文（若可用）。

    降级：如果 PluginOrchestrator 未安装，静默跳过。
    此函数与 adapter.store_routing_decision() 等价，但不引入硬依赖。
    """
    try:
        import sys
        if "plugin_orchestrator.context" not in sys.modules:
            return  # orchestrator 未加载，跳过

        ctx_mod = sys.modules["plugin_orchestrator.context"]
        get_or_create = getattr(ctx_mod, "get_or_create_context", None)
        if get_or_create is None:
            return

        ctx = get_or_create(session_id)
        ctx.shared_set("routing_decision", result)
        ctx.shared_set("model_selection", result.get("name", ""))
        ctx.shared_set("model_quality", result.get("quality", 3))
        ctx.shared_set("routing_strategy", result.get("strategy", "auto"))
        ctx.shared_set("budget_status", result.get("budget", {}))
        ctx.shared_set("provider_info", {
            "provider": result.get("provider", ""),
            "model": result.get("name", ""),
            "base_url": result.get("base_url", ""),
        })
        ctx.update_metadata(
            model=result.get("name", ""),
            provider=result.get("provider", ""),
        )
        # 发布事件：通知所有订阅者模型路由已完成
        ctx.event_bus.publish(
            "model_routed",
            source_plugin="model_router",
            session_id=session_id,
            model=result.get("name", ""),
            provider=result.get("provider", ""),
            strategy=result.get("strategy", "auto"),
        )
        logger.debug("Routing result written to PluginContext: %s → %s (%s)",
                     session_id[:8], result.get("name", ""), result.get("provider", ""))
    except Exception as exc:
        logger.debug("Model Router: 写入 PluginContext 失败: %s", exc)


# 开发阶段推断关键词
_DELIVER_KEYWORDS = ["测试", "review", "部署", "上线", "发布", "审查", "验收", "test", "deploy", "release", "ship"]
_BUILD_KEYWORDS = ["编码", "实现", "修复", "重构", "开发", "编写", "code", "implement", "fix", "refactor", "build", "debug"]


def _infer_dev_stage(message: str) -> str:
    """根据用户消息内容推断开发阶段（作为 dev-lifecycle 显式设置的兜底）。

    返回值:
        "deliver" — 测试/部署/上线阶段
        "build" — 编码/实现/修复阶段
        "" — 无法推断（不加成）
    """
    if not message:
        return ""
    msg_lower = message.lower()

    # 优先检测 deliver 关键词
    for kw in _DELIVER_KEYWORDS:
        if kw in msg_lower:
            return "deliver"

    # 其次检测 build 关键词
    for kw in _BUILD_KEYWORDS:
        if kw in msg_lower:
            return "build"

    # 其他情况不加成
    return ""


def handle_pre_llm_call(**kwargs) -> Optional[dict]:
    global _ama_task_weights, _ama_task_lock, _ROUTING_DISPLAY
    _apply_monkey_patch()
    _cleanup_stale_routing()

    # ── 预算管控 (LiteLLM 风格) ──
    budget_blocked = False
    budget_degraded = False
    budget_suggested_strategy = ""
    try:
        from .budget import check_budget as _check_budget
        budget = _check_budget()
        if not budget.get("allowed", True):
            # 预算超限：强制使用 cheapest 策略并过滤付费模型
            effective_strategy = budget.get("suggested_strategy", "cheapest")
            budget_suggested_strategy = effective_strategy
            budget_blocked = True
            logger.warning("预算超限，强制切换到 %s 策略", effective_strategy)
            # 通过 adapter 发布预算告警事件（adapter 不可用时静默）
            try:
                from .adapters_compat import notify_budget_warning
                notify_budget_warning(budget)
            except Exception as exc:
                logger.debug("Model Router: 发布预算告警事件失败: %s", exc)
        elif budget.get("degraded", False):
            # 预算降级：切换到 cheapest
            effective_strategy = budget.get("suggested_strategy", "cheapest")
            budget_suggested_strategy = effective_strategy
            budget_degraded = True
            logger.warning("预算降级，切换到 %s 策略", effective_strategy)
    except ImportError:
        pass

    session_id = kwargs.get("session_id", "")
    user_message = kwargs.get("user_message", "")
    messages = kwargs.get("messages", [])  # 完整消息列表（含历史）

    if not session_id or not user_message:
        return None

    _set_current_strategy(_get_strategy())

    # ── AMA 联动：检查任务权重，覆盖策略 ──
    effective_strategy = _get_current_strategy()
    ama_weight_reason = ""
    with _ama_task_lock:
        ama_score = _ama_task_weights.pop(session_id, None)
    if ama_score is not None:
        if ama_score <= 3:
            effective_strategy = "cheapest"
            ama_weight_reason = f" (AMA评分={ama_score:.1f}→cheapest)"
        elif ama_score >= 7:
            effective_strategy = "smartest"
            ama_weight_reason = f" (AMA评分={ama_score:.1f}→smartest)"

    # 预算管控优先级最高：覆盖 AMA 策略，强制使用 cheapest
    if budget_blocked or budget_degraded:
        effective_strategy = budget_suggested_strategy or "cheapest"

    # ── 估算 token 数量（用于长上下文绕路）──
    estimated_tokens = _estimate_tokens(messages) if messages else _estimate_user_message_tokens(user_message)

    # ── 读取 PluginContext 的阶段感知和缓存诊断信息 ──
    plugin_context = kwargs.get("plugin_context")
    dev_stage = ""
    if plugin_context:
        dev_stage = plugin_context.shared_get("dev_stage", "")

    # dev_stage 为空时根据消息内容自动推断
    if not dev_stage:
        dev_stage = _infer_dev_stage(user_message)
        if dev_stage:
            logger.debug("自动推断开发阶段: %s", dev_stage)

    cache_hit_rate = 0.0
    if plugin_context:
        cache_diag = plugin_context.shared_get("cache_hit_rate", 0.0)
        if cache_diag:
            cache_hit_rate = float(cache_diag)

    result = _route(user_message, effective_strategy, estimated_tokens=estimated_tokens,
                    dev_stage=dev_stage, cache_hit_rate=cache_hit_rate)
    if not result:
        return None

    # 写入预算管控状态到路由结果
    result["budget_blocked"] = budget_blocked
    result["budget_degraded"] = budget_degraded

    _ROUTER_STATE.set_decision(session_id, result)

    # ── PluginOrchestrator 集成：同时写入共享上下文 ──
    _store_result_to_plugin_context(session_id, result)

    # ── Prompt 自适应缩放 (v2.3, 参考 OpenSquilla SquillaRouter) ──
    prompt_hint = _get_prompt_scale_hint(result["complexity"], result.get("task_type", ""))

    ctx_parts = [
        f"[Model Router] 策略={effective_strategy}{ama_weight_reason}",
        f"复杂度={result['complexity']}/5",
        f"选中: {result['name']} ({result['provider']})",
        f"原因: {result['selection_reason']}",
        f"时间段: {result['time_info']['period']}",
    ]
    if prompt_hint:
        ctx_parts.append(f"Prompt缩放: {prompt_hint}")
    if result.get("long_context_bypass"):
        ctx_parts.insert(2, f"长上下文绕路: {estimated_tokens:,} tokens")
    if result.get("alternatives"):
        ctx_parts.append(f"降级链: {result['name']} → {' → '.join(result.get('alternatives', []))}")

    result_dict = {"context": " | ".join(ctx_parts), "prompt_scale": prompt_hint}

    # 发布路由决策到 PluginContext，供后续插件读取
    active = _get_active_model()
    result_dict["context_merge"] = {
        "model_selection": active.get("name", "") if active else "",
        "provider_info": active.get("provider", "") if active else "",
        "routing_strategy": _get_current_strategy(),
        "budget_blocked": budget_blocked,
        "budget_degraded": budget_degraded,
    }
    # 预算告警标记：其他插件通过 shared_get 读取此标记感知预算状态
    if budget_blocked or budget_degraded:
        result_dict["context_merge"]["budget_warning"] = True

    # 发布路由事件到 EventBus
    if active:
        result_dict["event"] = {
            "type": "model_routed",
            "model": active.get("name", ""),
            "provider": active.get("provider", ""),
        }

    return result_dict


def handle_post_llm_call(**kwargs) -> None:
    usage = kwargs.get("usage")
    if not usage:
        return
    try:
        from .cost_monitor import get_cost_monitor, CallStats
        model = kwargs.get("model", "")
        provider = kwargs.get("provider", "")
        latency = kwargs.get("latency_ms", 0)
        get_cost_monitor().record(CallStats(
            model=model,
            provider=provider,
            input_tokens=usage.get("prompt_tokens", 0),
            output_tokens=usage.get("completion_tokens", 0),
            cost_usd=_estimate_cost(model, provider, usage),
            latency_ms=latency,
            task_type=kwargs.get("task_type", "simple_qa"),
            complexity=str(kwargs.get("complexity", 3)),
            timestamp=time.time(),
        ))
    except Exception as exc:
        logger.warning("Model Router: post_llm_call 成本记录失败: %s", exc)


def handle_post_api_request(**kwargs) -> Optional[dict]:
    """检测 API 连续失败，自动触发降级。

    判定失败的依据（任一满足）：
      - error 字段非空（请求抛异常）
      - status_code 属于 429/500/502/503/504
      - response 对象的 status_code 属于上述范围

    连续失败 ≥3 次时执行：
      1. 将 provider 加入冷却黑名单（_add_provider_cooldown，默认 10s）
      2. 反馈到 CircuitBreaker（on_failure），使该 provider 在评分中沉底
      3. 记录模型失败反馈（record_model_feedback），影响后续评分
      4. 重置失败计数
      5. 通过 context_merge 发布 backpressure 事件，供下游插件感知

    注意：本钩子不直接调用 _try_fallback（其签名需要 agent 对象），
    而是通过冷却 + 熔断 + 反馈的组合，让下一次 pre_llm_call 路由时
    自动跳过该 provider，达到降级效果。
    """
    response = kwargs.get("response")
    status_code = kwargs.get("status_code")
    error = kwargs.get("error")
    model = kwargs.get("model", "")
    provider = kwargs.get("provider", "")
    session_id = kwargs.get("session_id", "default")

    # ── 判断是否为失败响应 ──
    is_failure = False
    if error:
        is_failure = True
    elif status_code and status_code in _FALLBACK_RETRYABLE_ERRORS:
        is_failure = True
    elif response is not None and hasattr(response, "status_code"):
        if response.status_code in _FALLBACK_RETRYABLE_ERRORS:
            is_failure = True

    if not is_failure:
        # 成功：重置失败计数
        if provider and model:
            _reset_provider_failures(provider, model)
        return None

    # 失败：累计计数
    if not provider or not model:
        return None

    consecutive = _record_provider_failure(provider, model)
    logger.warning(
        "Provider %s/%s 连续失败 %d 次 (session=%s)",
        provider, model, consecutive, session_id[:8] if session_id else "?",
    )

    # 连续失败 ≥3 次：触发降级
    if consecutive >= 3:
        logger.warning(
            "Provider %s/%s 连续失败 %d 次，触发自动降级（冷却+熔断+反馈）",
            provider, model, consecutive,
        )
        # 1. 将 provider 加入冷却黑名单，让下次路由跳过
        try:
            _add_provider_cooldown(provider)
        except Exception as e:
            logger.error("自动降级: 加入冷却黑名单失败: %s", e)

        # 2. 反馈到 CircuitBreaker，使该 provider 在评分中沉底
        try:
            _cb = _get_provider_breaker(provider, model)
            if _cb is not None:
                _cb.on_failure()
                logger.debug(
                    "Provider %s/%s CircuitBreaker 失败计数+1（连续失败自动降级）",
                    provider, model,
                )
        except Exception as e:
            logger.error("自动降级: CircuitBreaker 反馈失败: %s", e)

        # 3. 记录模型失败反馈，影响后续评分
        try:
            record_model_feedback(model, success=False)
        except Exception as e:
            logger.error("自动降级: 模型反馈记录失败: %s", e)

        # 4. 重置失败计数（已触发降级，避免重复触发）
        _reset_provider_failures(provider, model)

        # 5. 发布 backpressure 事件到 context，供下游插件感知
        return {
            "context_merge": {
                "backpressure_provider": provider,
                "backpressure_model": model,
                "backpressure_reason": f"连续失败{consecutive}次",
            }
        }

    return None


