# ── Provider 级 CircuitBreaker 管理 ──
# 复用 plugin-orchestrator 的 CircuitBreaker 类，按 "provider:model" 维度熔断。
# 当某 provider 连续失败（client 创建失败 / 触发降级）时，breaker 进入 OPEN，
# _score() 会给该 provider 极低分使其在路由中被跳过，等待 recovery_timeout 后恢复。
_provider_breakers: dict[str, Any] = {}  # key: "provider:model" → CircuitBreaker
_provider_breakers_lock = threading.Lock()
_CircuitBreakerClass = None  # 延迟加载的 CircuitBreaker 类
_CB_LOAD_TRIED = False


def _load_circuit_breaker_class():
    """延迟加载 plugin-orchestrator 的 CircuitBreaker 类。

    兼容多种加载场景：
      1. hermes 运行时（plugins.plugin_orchestrator 已注册）→ 直接 import
      2. plugin-orchestrator 已被 importlib 加载到 sys.modules → 从 sys.modules 取
      3. 以上均不可用 → importlib 从文件路径加载
      4. 全部失败 → 返回 None（breaker 不可用时默认放行）
    """
    global _CircuitBreakerClass, _CB_LOAD_TRIED
    if _CircuitBreakerClass is not None or _CB_LOAD_TRIED:
        return _CircuitBreakerClass
    _CB_LOAD_TRIED = True

    # 策略 1: 直接 import（hermes 运行时可用）
    try:
        from plugins.plugin_orchestrator.circuit_breaker import CircuitBreaker as _CB
        _CircuitBreakerClass = _CB
        return _CB
    except Exception as exc:
        logger.debug("Provider 级 breaker: 直接 import CircuitBreaker 失败，尝试从 sys.modules 加载: %s", exc)

    # 策略 2: 从 sys.modules 取（orchestrator 已加载）
    import sys as _sys
    _mod = _sys.modules.get("plugin_orchestrator.circuit_breaker")
    if _mod is not None:
        _CB = getattr(_mod, "CircuitBreaker", None)
        if _CB is not None:
            _CircuitBreakerClass = _CB
            return _CB

    # 策略 3: importlib 从文件路径加载
    try:
        import importlib.util
        import os as _os
        _cb_path = _os.path.join(
            _os.path.dirname(_os.path.dirname(_os.path.abspath(__file__))),
            "plugin-orchestrator", "circuit_breaker.py",
        )
        if _os.path.exists(_cb_path):
            _spec = importlib.util.spec_from_file_location(
                "plugin_orchestrator.circuit_breaker", _cb_path,
            )
            _mod = importlib.util.module_from_spec(_spec)
            _sys.modules["plugin_orchestrator.circuit_breaker"] = _mod
            _spec.loader.exec_module(_mod)
            _CB = getattr(_mod, "CircuitBreaker", None)
            if _CB is not None:
                _CircuitBreakerClass = _CB
                return _CB
    except Exception as exc:
        logger.debug("Provider 级 breaker: 加载 CircuitBreaker 失败: %s", exc)

    logger.debug("Provider 级 breaker: CircuitBreaker 不可用，provider 熔断降级为放行")
    return None


def _get_provider_breaker(provider: str, model: str):
    """获取或创建 provider 级 CircuitBreaker。

    key 为 "provider:model"，failure_threshold=3，recovery_timeout=60s。
    CircuitBreaker 不可用时返回 None（调用方应默认放行）。
    """
    if not provider or not model:
        return None
    key = f"{provider}:{model}"
    with _provider_breakers_lock:
        cb = _provider_breakers.get(key)
        if cb is not None:
            return cb
        # 延迟加载 CircuitBreaker 类
        cls = _CircuitBreakerClass
        if cls is None:
            cls = _load_circuit_breaker_class()
        if cls is None:
            return None
        try:
            # 复用 orchestrator 的 CircuitBreaker：plugin_name/hook_name 仅作标签
            cb = cls(
                provider, model,
                failure_threshold=3,
                recovery_timeout=60.0,  # 60 秒后尝试 HALF_OPEN 恢复
            )
            _provider_breakers[key] = cb
            return cb
        except Exception as exc:
            logger.debug("Provider 级 breaker: 创建 breaker 失败 %s: %s", key, exc)
            return None


def _is_provider_available(provider: str, model: str) -> bool:
    """检查 provider 是否可用（未被熔断）。

    breaker 不存在或不可用时默认可用（True）。
    """
    if provider == "mimo" and not get_model_router_config().get("mimo_enabled", True):
        return False
    breaker = _get_provider_breaker(provider, model)
    if breaker is None:
        return True
    try:
        # CircuitBreaker.is_open() 返回 True 表示处于熔断状态
        return not breaker.is_open()
    except Exception as exc:
        logger.warning("Provider 级 breaker: 检查 %s/%s 熔断状态失败，默认放行: %s", provider, model, exc)
        return True


# ── Provider 连续失败计数（用于 post_api_request 自动降级触发）──
# 与 CircuitBreaker 配合：breaker 负责评分沉底，本计数负责即时冷却降级
_provider_failure_counts: dict[str, int] = {}  # key: "provider:model" → 连续失败次数
_provider_failure_lock = threading.Lock()


def _record_provider_failure(provider: str, model: str) -> int:
    """记录 provider 连续失败，返回当前连续失败次数"""
    key = f"{provider}:{model}"
    with _provider_failure_lock:
        _provider_failure_counts[key] = _provider_failure_counts.get(key, 0) + 1
        return _provider_failure_counts[key]


def _reset_provider_failures(provider: str, model: str) -> None:
    """重置 provider 连续失败计数（成功时调用）"""
    key = f"{provider}:{model}"
    with _provider_failure_lock:
        _provider_failure_counts.pop(key, None)


def _load_rate_limits() -> dict[str, dict]:
    """从 config 读取 provider 级别限流配置，合并默认值（保留所有扩展字段）"""
    configured = get_model_router_config().get("rate_limits", {})
    merged = dict(_DEFAULT_RATE_LIMITS)
    for prov, limits in configured.items():
        if isinstance(limits, dict):
            # 合并默认值，config 中的值覆盖默认值
            default = _DEFAULT_RATE_LIMITS.get(prov, {})
            merged[prov] = {
                "rate": limits.get("rate", default.get("rate", 1.0)),
                "capacity": limits.get("capacity", default.get("capacity", 60)),
            }
            # 保留扩展字段（daily_limit, timeout, retry_after, priority, comment 等）
            for key in ["daily_limit", "timeout", "retry_after", "priority", "comment"]:
                if key in limits:
                    merged[prov][key] = limits[key]
                elif key in default:
                    merged[prov][key] = default[key]
    return merged


def _check_rate_limit(provider: str) -> bool:
    """令牌桶算法：检查 provider 是否有可用令牌。
    有令牌则消耗 1 个并返回 True，否则返回 False。
    """
    limits = _load_rate_limits()
    limit = limits.get(provider)
    if not limit:
        return True  # 无限流配置，放行

    with _RATE_LIMIT_LOCK:
        now = time.monotonic()
        if provider not in _RATE_LIMIT_BUCKETS:
            _RATE_LIMIT_BUCKETS[provider] = {
                "tokens": float(limit["capacity"]),
                "last_refill": now,
                "rate": limit["rate"],
                "capacity": limit["capacity"],
            }
        bucket = _RATE_LIMIT_BUCKETS[provider]

        # 补齐令牌
        elapsed = now - bucket["last_refill"]
        refill = elapsed * bucket["rate"]
        bucket["tokens"] = min(float(bucket["capacity"]), bucket["tokens"] + refill)
        bucket["last_refill"] = now

        if bucket["tokens"] >= 1.0:
            bucket["tokens"] -= 1.0
            return True
        else:
            return False


def get_rate_limit_status(provider: str = None) -> dict:
    """查询限流状态"""
    limits = _load_rate_limits()
    with _RATE_LIMIT_LOCK:
        # 先补齐所有桶
        now = time.monotonic()
        for pname, bucket in list(_RATE_LIMIT_BUCKETS.items()):
            elapsed = now - bucket["last_refill"]
            refill = elapsed * bucket["rate"]
            bucket["tokens"] = min(float(bucket["capacity"]), bucket["tokens"] + refill)
            bucket["last_refill"] = now

        if provider:
            bucket = _RATE_LIMIT_BUCKETS.get(provider)
            if not bucket:
                return {"provider": provider, "limited": False, "reason": "无限制"}
            return {
                "provider": provider,
                "limited": bucket["tokens"] < 1.0,
                "available_tokens": round(bucket["tokens"], 1),
                "capacity": bucket["capacity"],
                "rate_per_sec": bucket["rate"],
                "rate_per_min": round(bucket["rate"] * 60, 1),
            }

        result = {}
        for pname, bucket in _RATE_LIMIT_BUCKETS.items():
            result[pname] = {
                "limited": bucket["tokens"] < 1.0,
                "available_tokens": round(bucket["tokens"], 1),
                "capacity": bucket["capacity"],
                "rate_per_sec": bucket["rate"],
                "rate_per_min": round(bucket["rate"] * 60, 1),
            }
        return result

def _get_provider_cooldown_duration() -> float:
