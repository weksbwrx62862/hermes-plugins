_FEEDBACK_TTL: float = 86400.0  # 24 小时衰减


class RouterState:
    """维护路由决策表与模型反馈状态，线程安全。"""

    def __init__(self):
        self._routing_decisions: dict[str, dict] = {}
        self._routing_lock = threading.Lock()
        self._routing_cleanup_time: float = 0.0
        self._model_feedback: dict[str, dict] = {}
        self._feedback_lock = threading.Lock()

    def get_decision(self, session_id: str) -> Optional[dict]:
        with self._routing_lock:
            entry = self._routing_decisions.get(session_id)
            return entry.get("decision") if isinstance(entry, dict) else entry

    def set_decision(self, session_id: str, decision: dict) -> None:
        with self._routing_lock:
            self._routing_decisions[session_id] = {
                "decision": decision, "_created_at": time.time(),
            }

    def pop_decision(self, session_id: str) -> Optional[dict]:
        with self._routing_lock:
            entry = self._routing_decisions.pop(session_id, None)
            return entry.get("decision") if isinstance(entry, dict) else entry

    def cleanup_decisions(self, now: float, max_age: float) -> int:
        with self._routing_lock:
            expired = [
                sid for sid, entry in self._routing_decisions.items()
                if isinstance(entry, dict) and (now - entry.get("_created_at", 0)) > max_age
            ]
            for sid in expired:
                del self._routing_decisions[sid]
            return len(expired)

    def is_cleanup_due(self, now: float, interval: float) -> bool:
        return now - self._routing_cleanup_time >= interval

    def mark_cleanup(self, now: float) -> None:
        self._routing_cleanup_time = now

    def record_feedback(
        self, model_name: str, success: bool, token_usage: int = 0,
        task_type: str = "chat", complexity: int = 3,
    ) -> None:
        import time as _time
        with self._feedback_lock:
            if model_name not in self._model_feedback:
                self._model_feedback[model_name] = {
                    "successes": 0, "failures": 0, "total_tokens": 0,
                    "last_time": 0, "penalty": 0.0,
                }
            fb = self._model_feedback[model_name]
            # 衰减旧 penalty
            elapsed = _time.time() - fb["last_time"] if fb["last_time"] else _FEEDBACK_TTL
            if elapsed > 0:
                decay = max(0, 1 - elapsed / _FEEDBACK_TTL)
                fb["penalty"] *= decay

            if success:
                fb["successes"] += 1
                fb["penalty"] = max(0, fb["penalty"] - 0.05)  # 成功减 penalty
            else:
                fb["failures"] += 1
                fb["penalty"] += 0.3  # 失败加 penalty
            fb["total_tokens"] += token_usage
            fb["last_time"] = _time.time()

    def get_feedback_score(self, model_name: str) -> float:
        with self._feedback_lock:
            fb = self._model_feedback.get(model_name)
            if not fb:
                return 0.0
            total = fb["successes"] + fb["failures"]
            if total < 2:
                return 0.0  # 样本太少不调整
            return -fb["penalty"]  # penalty 越大，返回越负


