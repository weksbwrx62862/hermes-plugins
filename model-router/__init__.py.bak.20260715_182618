def _pick_key_for_provider(provider: str, config_provider_name: str, env_vars: list[str], preferred_count: int = 0) -> str:
    """通用多 key 轮转：Round-Robin 平均分流 + 健康检测跳过不健康 key

    Args:
        preferred_count: 优先 key 数量。>0 时，轮转只在前 N 个 key 间进行，
                        主用 key 全部不健康时才降级到备选 key。
    """
    keys = []
    for var in env_vars:
        val = os.environ.get(var, "").strip()
        if val and val not in keys:
            keys.append(val)
    if not keys:
        return get_provider_config(config_provider_name).get("api_key", "")
    if len(keys) == 1:
        return keys[0]

    with _KEY_ROUND_ROBIN_LOCK:
        rr_key = f"{provider}_preferred" if preferred_count > 0 else provider
        if rr_key not in _KEY_ROUND_ROBIN:
            _KEY_ROUND_ROBIN[rr_key] = 0

        # 如果有优先 key，先在优先 key 间轮转
        if preferred_count > 0 and preferred_count < len(keys):
            preferred_keys = keys[:preferred_count]
            fallback_keys = keys[preferred_count:]
            n = len(preferred_keys)
            for offset in range(n):
                idx = (_KEY_ROUND_ROBIN[rr_key] + offset) % n
                key = preferred_keys[idx]
                if _is_key_healthy(key) and not _is_key_rate_limited(key):
                    _KEY_ROUND_ROBIN[rr_key] = (idx + 1) % n
                    with _KEY_USAGE_LOCK:
                        if key not in _KEY_USAGE:
                            _KEY_USAGE[key] = 0
                        _KEY_USAGE[key] += 1
                    return key

            # 所有主用 key 都不健康，降级到备选 key
            logger.warning("Model Router: %s 主用 Key (前%d个) 均不健康，降级到备选 Key", provider, preferred_count)
            for key in fallback_keys:
                if _is_key_healthy(key) and not _is_key_rate_limited(key):
                    with _KEY_USAGE_LOCK:
                        if key not in _KEY_USAGE:
                            _KEY_USAGE[key] = 0
                        _KEY_USAGE[key] += 1
                    return key

            # 备选也不健康，用最少使用的
            logger.warning("Model Router: 所有 %s Key 均不健康，降级使用最少使用策略", provider)
            with _KEY_USAGE_LOCK:
                min_key = min(keys, key=lambda k: _KEY_USAGE.get(k, 0))
                _KEY_USAGE[min_key] = _KEY_USAGE.get(min_key, 0) + 1
                return min_key

        # 无优先 key 配置，原始 round-robin 逻辑
        n = len(keys)
        for offset in range(n):
            idx = (_KEY_ROUND_ROBIN[rr_key] + offset) % n
            key = keys[idx]
            if _is_key_healthy(key) and not _is_key_rate_limited(key):
                _KEY_ROUND_ROBIN[rr_key] = (idx + 1) % n
                with _KEY_USAGE_LOCK:
                    if key not in _KEY_USAGE:
                        _KEY_USAGE[key] = 0
                    _KEY_USAGE[key] += 1
                return key

        # 所有 key 都不健康，强制用最少使用的
        logger.warning("Model Router: 所有 %s Key 均不健康，降级使用最少使用策略", provider)
        with _KEY_USAGE_LOCK:
            min_key = min(keys, key=lambda k: _KEY_USAGE.get(k, 0))
            _KEY_USAGE[min_key] = _KEY_USAGE.get(min_key, 0) + 1
            return min_key


def _build_mimo_key_to_base_url() -> dict[str, str]:
    global _MIMO_KEY_TO_BASE_URL, _MIMO_KEY_TO_BASE_URL_TIME
    now = time.time()
    if _MIMO_KEY_TO_BASE_URL is not None and (now - _MIMO_KEY_TO_BASE_URL_TIME) < 30.0:
        return _MIMO_KEY_TO_BASE_URL

    default_base = get_provider_config("mimo").get("base_url", "")
    env_vars, _ = _load_mimo_key_config()
    mapping: dict[str, str] = {}
    for var in env_vars:
        key_val = os.environ.get(var, "").strip()
        if not key_val:
            continue
        suffix = var.replace("MIMO_API_KEY", "")
        url_var = f"MIMO_BASE_URL{suffix}"
        per_key_url = os.environ.get(url_var, "").strip().rstrip("/")
        mapping[key_val] = per_key_url or default_base

    _MIMO_KEY_TO_BASE_URL = mapping
    _MIMO_KEY_TO_BASE_URL_TIME = now
    return mapping


def _get_base_url_for_mimo_key(key: str, fallback: str = "") -> str:
    mapping = _build_mimo_key_to_base_url()
    return mapping.get(key, fallback)


def _pick_mimo_key() -> str:
    env_vars, preferred_count = _load_mimo_key_config()
