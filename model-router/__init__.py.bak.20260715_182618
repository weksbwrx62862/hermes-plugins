def _is_tts(name: str) -> bool:
    return "tts" in name.lower()


def _infer_attrs(name: str, provider: str) -> tuple:
    """从 config 模型属性表查，查不到再用启发式推断。
    
    Returns: (cost, speed, quality, context_window)
    """
    # 优先查 config
    model_attrs = get_model_router_config().get("model_attrs", {})
    for pattern, attrs in model_attrs.items():
        if pattern.lower() in name.lower() and isinstance(attrs, dict):
            return (
                attrs.get("cost", 2),
                attrs.get("speed", 3),
                attrs.get("quality", 4),
                attrs.get("context_window", 128_000),
            )

    # fallback 启发式
    lower = name.lower()
    prov = provider.lower()

    if _is_tts(name):
        return (0, 3, 4, 128_000)

    if prov == "mimo":
        if "pro" in lower and ("2.5" in lower or "v2.5" in lower):
            return (3, 3, 5, 1_000_000)
        if "pro" in lower:
            return (3, 3, 5, 1_000_000)
        if "omni" in lower:
            return (3, 2, 5, 256_000)
        return (2, 3, 4, 1_000_000)

    # NVIDIA NIM 必须优先于通用 deepseek 匹配（否则 cost 计算错误）
    if prov == "nvidia-nim":
        if "deepseek" in lower and "pro" in lower:
            return (99, 2, 5, 1_000_000)   # V4 Pro (penalized - prefer openai)
        if "deepseek" in lower and "flash" in lower:
            return (99, 5, 4, 1_000_000)   # V4 Flash (penalized - prefer openai)
        if "gpt-oss" in lower:
            return (0, 3, 4, 128_000)     # GPT-OSS
        if "mistral-large-3" in lower or "675b" in lower:
            return (0, 3, 5, 128_000)     # Mistral Large 3 675B
        if "mistral-medium" in lower or "128b" in lower:
            return (0, 4, 4, 128_000)     # Mistral Medium 3.5
        if "glm" in lower:
            return (0, 3, 4, 128_000)     # GLM
        if "qwen3.5" in lower or "397b" in lower:
            return (0, 2, 3, 131_072)     # Qwen 397B
        if "nemotron-super" in lower and "49b" in lower:
            return (0, 1, 1, 128_000)     # ⛔ Nemotron 49B
        if "llama-4" in lower or "maverick" in lower:
            return (0, 5, 4, 1_000_000)   # Llama4（可能限流）
        if "minimax" in lower:
            return (0, 3, 4, 128_000)     # MiniMax
        return (0, 3, 4, 128_000)

    # 阶跃星辰：稳定免费，优先使用
    if prov == "stepfun" or "step-" in lower:
        if "3.7" in lower:
            return (0, 5, 4, 128_000)     # Step 3.7 Flash（快速高质量）
        if "3.5" in lower:
            return (0, 5, 3, 128_000)     # Step 3.5 Flash（快速）
        return (0, 4, 4, 128_000)         # 其他 Step 模型

    # 商汤（sensenova）：稳定免费，第三优先
    if prov == "sensenova" or "sensenova" in lower:
        if "deepseek" in lower:
            return (0, 5, 4, 128_000)     # 商汤代理 DeepSeek（快速高质量）
        if "glm" in lower:
            return (0, 4, 4, 128_000)     # GLM 系列
        if "flash-lite" in lower or "6.7" in lower:
            return (0, 5, 3, 128_000)     # Flash Lite（轻量快速）
        return (0, 4, 3, 128_000)         # 其他商汤模型

    # 阿里百炼（dashscope）：免费，第四优先
    if prov == "dashscope" or "dashscope" in lower:
        if "deepseek" in lower and "pro" in lower:
            return (0, 4, 5, 128_000)     # DeepSeek Pro（额度已耗尽，但保留属性）
        if "deepseek" in lower and "flash" in lower:
            return (0, 5, 4, 128_000)     # DeepSeek Flash（额度已耗尽）
        if "qwen3.7" in lower and "max" in lower:
            return (0, 3, 5, 131_072)     # Qwen3.7 Max（最强Qwen）
        if "qwen3.7" in lower and "plus" in lower:
            return (0, 4, 4, 131_072)     # Qwen3.7 Plus
        if "qwen3.6" in lower and "flash" in lower:
            return (0, 5, 4, 128_000)     # Qwen3.6 Flash（快速）
        if "qwen3.6" in lower and "plus" in lower:
            return (0, 4, 4, 128_000)     # Qwen3.6 Plus
        if "qwen3.5" in lower and "plus" in lower:
            return (0, 4, 4, 128_000)     # Qwen3.5 Plus
        if "qwen3.5" in lower and "flash" in lower:
            return (0, 5, 3, 128_000)     # Qwen3.5 Flash
        if "qwen3-coder" in lower:
            return (0, 4, 4, 262_144)     # Qwen3 Coder
        if "glm-5.2" in lower:
            return (0, 4, 4, 128_000)     # GLM 5.2
        if "glm-5.1" in lower:
            return (0, 4, 4, 128_000)     # GLM 5.1
        if "glm-5" in lower and "5." not in lower:
            return (0, 3, 4, 128_000)     # GLM 5
        if "kimi" in lower and "coder" in lower:
            return (0, 4, 5, 128_000)     # Kimi Coder（强代码能力）
        if "kimi" in lower:
            return (0, 4, 4, 128_000)     # Kimi 系列
        if "minimax" in lower:
            return (0, 3, 4, 128_000)     # MiniMax
        return (0, 4, 4, 128_000)         # 其他百炼模型

    # Agnes AI：免费，第五优先
    if prov == "agnes" or "agnes" in lower:
        if "2.0" in lower and "flash" in lower:
            return (0, 5, 4, 128_000)     # Agnes 2.0 Flash（快速高质量）
        if "1.5" in lower and "flash" in lower:
            return (0, 5, 3, 128_000)     # Agnes 1.5 Flash（轻量快速）
        return (0, 4, 3, 128_000)         # 其他 Agnes 模型

    if "deepseek" in lower or prov in ("openai", "deepseek"):
        # 官方 DeepSeek API 评分对齐 nvidia-nim，优先使用
        if prov == "openai":
            if "pro" in lower:
                return (0, 2, 6, 1_000_000)   # 官方 V4 Pro (quality=6 优先)
            if "flash" in lower:
                return (0, 5, 5, 1_000_000)   # 官方 V4 Flash (quality=5 优先)
            return (0, 3, 5, 128_000)
        if "pro" in lower or "v4-pro" in lower:
            return (3, 2, 5, 1_000_000)
        if "flash" in lower or "v4-flash" in lower:
            return (1, 5, 3, 1_000_000)
        return (2, 3, 4, 128_000)

    return (2, 3, 3, 128_000)


