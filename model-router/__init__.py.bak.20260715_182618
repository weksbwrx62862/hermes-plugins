def _apply_routing(agent, routing: dict) -> bool:
    try:
        new_model = routing.get("model", "")
        new_provider = routing.get("provider", "")
        new_base_url = routing.get("base_url", "")
        new_key = routing.get("key", "")

        if not new_model:
            return False

        api_mode = getattr(agent, "api_mode", "chat_completions")
        if api_mode not in ("chat_completions", "codex_responses"):
            return True

        old_model = getattr(agent, "model", "")
        old_provider = getattr(agent, "provider", "")
        old_key = getattr(agent, "api_key", "") or getattr(agent, "_api_key", "")
        old_base_url = getattr(agent, "base_url", None)

        model_changed = new_model != old_model
        provider_changed = new_provider != old_provider
        key_changed = new_key and new_key != old_key

        if not model_changed and not provider_changed and not key_changed:
            return True

        agent.model = new_model
        agent.provider = new_provider
        if hasattr(agent, "base_url"):
            agent.base_url = new_base_url

        if new_provider == "moa":
            _auto_moa = routing.get("moa_config") or {}
            _agg = _auto_moa.get("aggregator", {})
            agent.moa_config = _auto_moa
            agent.moa_auto_triggered = True
            # 实际 LLM 调用使用聚合器模型（MoA 参考模型在 conversation_loop 中先并行执行）
            _agg_prov = _agg.get("provider", "openai")
            _agg_model = _agg.get("model", "deepseek-v4-pro")
            agent.model = _agg_model
            agent.provider = _agg_prov
            # 加载聚合器 provider 的 base_url 和 api_key
            _agg_prov_cfg = _load_config().get("providers", {}).get(_agg_prov, {})
            if _agg_prov_cfg.get("base_url"):
                if hasattr(agent, "base_url"):
                    agent.base_url = _agg_prov_cfg["base_url"]
            _agg_key = _get_key_for_provider(_agg_prov)
            if _agg_key:
                for attr in ("api_key", "_api_key"):
                    if hasattr(agent, attr):
                        setattr(agent, attr, _agg_key)
                if hasattr(agent, "_client_kwargs"):
                    ck = dict(getattr(agent, "_client_kwargs", {}))
                    ck["api_key"] = _agg_key
                    ck["base_url"] = getattr(agent, "base_url", "")
                    agent._client_kwargs = ck
                if hasattr(agent, "_transport_cache"):
                    agent._transport_cache.clear()
                if hasattr(agent, "_create_openai_client") and callable(agent._create_openai_client):
                    try:
                        agent.client = agent._create_openai_client(
                            dict(getattr(agent, "_client_kwargs", {})),
                            reason="model-router-moa",
                            shared=True,
                        )
                    except Exception as exc:
                        logger.warning("Model Router: MoA aggregator client 创建失败: %s", exc)

        if new_key:
            for attr in ("api_key", "_api_key"):
                if hasattr(agent, attr):
                    setattr(agent, attr, new_key)

        if provider_changed or key_changed:
            if hasattr(agent, "_transport_cache"):
                agent._transport_cache.clear()

            if hasattr(agent, "_client_kwargs"):
                old_ck = dict(getattr(agent, "_client_kwargs", {}))
                old_ck["api_key"] = new_key
                old_ck["base_url"] = new_base_url
                agent._client_kwargs = old_ck

            if hasattr(agent, "_create_openai_client") and callable(agent._create_openai_client):
                try:
                    agent.client = agent._create_openai_client(
                        dict(getattr(agent, "_client_kwargs", {})),
                        reason="model-router",
                        shared=True,
                    )
                    if new_key:
                        record_key_success(new_key)
                except Exception as exc:
                    logger.warning("Model Router: _create_openai_client failed: %s", exc)
                    if new_key:
                        record_key_failure(new_key)
                    try:
                        from openai import OpenAI
                        agent.client = OpenAI(api_key=new_key, base_url=new_base_url)
                    except Exception as exc2:
                        logger.warning("Model Router: OpenAI client fallback also failed: %s", exc2)
                        if new_key:
                            record_key_failure(new_key)
                        # ── 反馈联动：记录模型失败 ──
                        record_model_feedback(new_model, success=False)
                        # ── Provider 级熔断：client 创建失败，breaker 失败计数+1 ──
                        _cb = _get_provider_breaker(new_provider, new_model)
                        if _cb is not None:
                            _cb.on_failure()
                            logger.warning(
                                "Provider %s/%s client 创建失败，CircuitBreaker 失败计数+1",
                                new_provider, new_model,
                            )
                        # ── 回滚：client 创建失败，恢复 agent 旧属性 ──
                        agent.model = old_model
                        agent.provider = old_provider
                        if old_base_url is not None:
                            agent.base_url = old_base_url
                        for attr in ("api_key", "_api_key"):
                            if hasattr(agent, attr):
                                setattr(agent, attr, old_key)
                        logger.error("Model Router: Client 创建失败，已回滚所有属性: %s", exc2)
                else:
                    # ── 反馈联动：记录模型成功 ──
                    record_model_feedback(new_model, success=True)
                    # ── Provider 级熔断：client 创建成功，breaker 成功反馈 ──
                    _cb = _get_provider_breaker(new_provider, new_model)
                    if _cb is not None:
                        _cb.on_success()

        reason = routing.get("selection_reason", "")
        logger.info(
            "Model Router: [%s] %s/%s → %s/%s | %s",
            getattr(agent, "session_id", "")[:8] if hasattr(agent, "session_id") else "?",
            old_model, old_provider, new_model, new_provider, reason,
        )

        fb_chain = routing.get("fallback_chain", [])
        if fb_chain:
            agent._fallback_chain = fb_chain
            agent._fallback_index = 0
            agent._fallback_activated = False
            logger.info(
                "Model Router: 已设置 %d 个降级备选模型 [%s]",
                len(fb_chain),
                ", ".join(fb["model"] for fb in fb_chain[:3]),
            )

        try:
            from .cost_monitor import get_cost_monitor, CallStats
            get_cost_monitor().record(CallStats(
                model=new_model,
                provider=new_provider,
                input_tokens=0,
                output_tokens=0,
                cost_usd=0.0,
                latency_ms=0.0,
                task_type=routing.get("task_type", "simple_qa"),
                complexity=str(routing.get("complexity", 3)),
                timestamp=time.time(),
            ))
        except Exception as exc:
            logger.warning("Model Router: 记录路由成本监控失败: %s", exc)

        return True
    except Exception as exc:
        logger.warning("Model Router: apply routing failed: %s", exc)
        return False


_FALLBACK_RETRYABLE_ERRORS = {429, 500, 502, 503, 504}


def _get_key_for_provider(provider: str, base_url: str = "") -> str:
    """根据 provider 动态获取一个可用 API Key（降级链中不存储明文 key 时使用）。"""
    if provider == "mimo":
        return _pick_mimo_key()
    if provider == "nvidia-nim":
        return _pick_nvidia_key()
    return get_provider_config(provider).get("api_key", "")


def _try_fallback(agent, exc: Exception) -> bool:
    chain = getattr(agent, "_fallback_chain", [])
    idx = getattr(agent, "_fallback_index", 0)

    if not chain or idx >= len(chain):
        return False

    status_code = getattr(exc, "status_code", None)
    if status_code and status_code not in _FALLBACK_RETRYABLE_ERRORS:
        return False

    # Record current key as rate-limited on 429
    if status_code == 429:
        current_key = getattr(agent, "api_key", "") or getattr(agent, "_api_key", "")
        if current_key:
            record_key_rate_limited(current_key)

    # ── Provider 级熔断：原始 provider 失败（触发降级），反馈到 breaker ──
    _old_model = getattr(agent, "model", "")
    _old_provider = getattr(agent, "provider", "")
    _old_cb = _get_provider_breaker(_old_provider, _old_model)
    if _old_cb is not None:
        _old_cb.on_failure()
        logger.debug(
            "Provider %s/%s 触发降级，CircuitBreaker 失败计数+1",
            _old_provider, _old_model,
        )

    for i in range(idx, len(chain)):
        fb = chain[i]
        if fb.get("cooldown") or fb.get("rate_limited"):
            continue

        logger.warning(
            "Model Router: 降级 %s → %s (原因: %s)",
            getattr(agent, "model", ""), fb["model"], str(exc)[:100],
        )

        agent.model = fb["model"]
        agent.provider = fb["provider"]
        if hasattr(agent, "base_url"):
            agent.base_url = fb["base_url"]

        fb_key = fb.get("api_key", "")
        if not fb_key:
            # 降级链中不存储明文 key，按 provider 动态获取
            fb_key = _get_key_for_provider(fb["provider"], fb.get("base_url", ""))
        if fb_key:
            for attr in ("api_key", "_api_key"):
                if hasattr(agent, attr):
                    setattr(agent, attr, fb_key)
            if hasattr(agent, "_client_kwargs"):
                ck = dict(getattr(agent, "_client_kwargs", {}))
                ck["api_key"] = fb_key
                ck["base_url"] = fb.get("base_url", "")
                agent._client_kwargs = ck
            if hasattr(agent, "_transport_cache"):
                agent._transport_cache.clear()
            if hasattr(agent, "_create_openai_client") and callable(agent._create_openai_client):
                try:
                    agent.client = agent._create_openai_client(
                        dict(getattr(agent, "_client_kwargs", {})),
                        reason="model-router-fallback",
                        shared=True,
                    )
                except Exception as exc:
                    logger.warning("Model Router: fallback 创建 _create_openai_client 失败，尝试直接 OpenAI: %s", exc)
                    try:
                        from openai import OpenAI
                        agent.client = OpenAI(api_key=fb_key, base_url=fb.get("base_url", ""))
                    except Exception as exc2:
                        logger.warning("Model Router: fallback 创建 OpenAI client 也失败: %s", exc2)
                        # fallback provider client 创建也失败，breaker 失败反馈
                        _fail_cb = _get_provider_breaker(fb["provider"], fb["model"])
                        if _fail_cb is not None:
                            _fail_cb.on_failure()

        agent._fallback_index = i + 1
        agent._fallback_activated = True
        record_model_feedback(fb["model"], success=False)
        # ── Provider 级熔断：成功切换到 fallback，新 provider 成功反馈 ──
        _new_cb = _get_provider_breaker(fb["provider"], fb["model"])
        if _new_cb is not None:
            _new_cb.on_success()
        return True

    return False


# ═══════════════════════════════════════════════════════════════════
# Monkey-patch：拦截 _build_api_kwargs
# ═══════════════════════════════════════════════════════════════════

def _build_api_kwargs_patched(self, api_messages: list) -> dict:
    global _original_build_api_kwargs
    session_id = getattr(self, "session_id", "") or ""
    routing = _ROUTER_STATE.pop_decision(session_id)
    if routing:
        _apply_routing(self, routing)
    try:
        kwargs = _original_build_api_kwargs(self, api_messages)
        # 根据模型调整 max_tokens，避免超过模型限制导致 400 错误
        _cur_model = (getattr(self, "model", "") or "").lower()
        _cur_prov = (getattr(self, "provider", "") or "").lower()
        _cur_max = kwargs.get("max_tokens", 0) or 0
        if _cur_max > 32768 and ("qwen" in _cur_model or "dashscope" in _cur_prov):
            kwargs["max_tokens"] = 32768
            logger.info("Model Router: %s/%s max_tokens 限制为 32768（原 %d）", _cur_prov, _cur_model, _cur_max)
        return kwargs
    except Exception as exc:
        # Record rate-limited key on 429 errors
        status_code = getattr(exc, "status_code", None)
        if status_code == 429:
            current_key = getattr(self, "api_key", "") or getattr(self, "_api_key", "")
            if current_key:
                record_key_rate_limited(current_key)
        elif status_code == 403:
            # 403 通常是免费额度用完或权限拒绝，长时间冷却该 provider（1 小时）
            # 避免 dashscope/sensenova 等免费渠道额度耗尽后仍被反复重试
            current_provider = getattr(self, "provider", "") or ""
            if current_provider:
                with _PROVIDER_COOLDOWN_LOCK:
                    _PROVIDER_COOLDOWN[current_provider] = time.time() + 3600
                logger.warning("Model Router: %s 返回 403（额度用完/权限拒绝），冷却 1 小时", current_provider)
        if _try_fallback(self, exc):
            try:
                return _original_build_api_kwargs(self, api_messages)
            except Exception:
                raise
        raise


# ── try_activate_fallback patch：403 auth 错误时冷却 provider ──
_original_try_activate_fallback = None


def _try_activate_fallback_patched(agent, reason=None):
    """拦截 fallback 激活，当检测到 403 auth 错误时冷却当前 provider。

    403 通常表示免费额度用完或权限拒绝，冷却整个 provider 1 小时，
    避免后续请求继续路由到该 provider 导致重复 403。
    """
    if reason is not None:
        reason_name = getattr(reason, "name", str(reason))
        if reason_name == "auth":
            current_provider = (getattr(agent, "provider", "") or "").strip().lower()
            if current_provider:
                with _PROVIDER_COOLDOWN_LOCK:
                    _PROVIDER_COOLDOWN[current_provider] = time.time() + 3600
                logger.warning(
                    "Model Router: %s 返回 403（auth），冷却 1 小时，后续请求将跳过该 provider",
                    current_provider,
                )
    return _original_try_activate_fallback(agent, reason)


def _find_ai_agent_class():
    """尝试多种方式定位 AIAgent 类，降低对单一加载顺序的依赖。"""
    import sys as _sys
    # 1. 已在 sys.modules 中
    for mod_name in ("run_agent", "agent.run_agent", "hermes.run_agent"):
        mod = _sys.modules.get(mod_name)
        if mod is not None and hasattr(mod, "AIAgent"):
            return mod.AIAgent
    # 2. 尝试导入
    for mod_name in ("run_agent", "agent.run_agent", "hermes.run_agent"):
        try:
            mod = __import__(mod_name, fromlist=["AIAgent"])
            return getattr(mod, "AIAgent")
        except Exception:
            continue
    return None


def _apply_monkey_patch():
    global _original_build_api_kwargs, _patch_applied, _patch_lock, _patch_retry_count
    if _patch_applied:
        return
    if _patch_retry_count >= _PATCH_MAX_RETRIES:
        return
    with _patch_lock:
        if _patch_applied:
            return
        if _patch_retry_count >= _PATCH_MAX_RETRIES:
            return
        try:
            _AIAgent = _find_ai_agent_class()
            if _AIAgent is None:
                _patch_retry_count += 1
                if _patch_retry_count >= _PATCH_MAX_RETRIES:
                    logger.warning(
                        "Model Router: monkey-patch failed after %d attempts, giving up",
                        _PATCH_MAX_RETRIES,
                    )
                else:
                    logger.debug(
                        "Model Router: AIAgent not loaded yet, retry %d/%d",
                        _patch_retry_count, _PATCH_MAX_RETRIES,
                    )
                return
            if not hasattr(_AIAgent, "_build_api_kwargs"):
                _patch_retry_count += 1
                if _patch_retry_count >= _PATCH_MAX_RETRIES:
                    logger.warning(
                        "Model Router: AIAgent._build_api_kwargs not found after %d attempts, giving up",
                        _PATCH_MAX_RETRIES,
                    )
                else:
                    logger.debug(
                        "Model Router: AIAgent._build_api_kwargs not found, retry %d/%d",
                        _patch_retry_count, _PATCH_MAX_RETRIES,
                    )
                return
            _original_build_api_kwargs = _AIAgent._build_api_kwargs
            _AIAgent._build_api_kwargs = _build_api_kwargs_patched
            _patch_applied = True
            logger.info("Model Router: monkey-patch applied to AIAgent._build_api_kwargs")
            # 同时 patch try_activate_fallback，拦截 403 auth 错误冷却 provider
            global _original_try_activate_fallback
            try:
                import agent.chat_completion_helpers as _cch
                _original_try_activate_fallback = _cch.try_activate_fallback
                _cch.try_activate_fallback = _try_activate_fallback_patched
                logger.info("Model Router: monkey-patch applied to chat_completion_helpers.try_activate_fallback")
            except Exception as _fb_exc:
                logger.warning("Model Router: patch try_activate_fallback 失败: %s", _fb_exc)
        except Exception as exc:
            _patch_retry_count += 1
            logger.warning("Model Router: monkey-patch failed (attempt %d/%d): %s", _patch_retry_count, _PATCH_MAX_RETRIES, exc)


