def _load_config() -> dict:
    global _CONFIG_CACHE, _CONFIG_CACHE_TIME
    now = time.time()
    if _CONFIG_CACHE is not None and (now - _CONFIG_CACHE_TIME) < _CONFIG_CACHE_TTL:
        return _CONFIG_CACHE
    try:
        import yaml
    except ImportError:
        logger.warning("Model Router: PyYAML not installed, cannot read config.yaml")
        return {}
    config_path = os.path.expanduser("~/.hermes/config.yaml")
    if not os.path.exists(config_path):
        return {}
    try:
        with open(config_path) as f:
            cfg = yaml.safe_load(f) or {}
        _CONFIG_CACHE = cfg
        _CONFIG_CACHE_TIME = now
        return cfg
    except Exception as exc:
        logger.warning("Model Router: failed to read config.yaml: %s", exc)
        return {}


def invalidate_config_cache() -> None:
    global _CONFIG_CACHE, _CONFIG_CACHE_TIME
    _CONFIG_CACHE = None
    _CONFIG_CACHE_TIME = 0.0


def get_model_router_config() -> dict[str, Any]:
    """获取 plugins.model-router 配置节点，减少重复 I/O。"""
    return _load_config().get("plugins", {}).get("model-router", {})


def get_provider_config(provider: str) -> dict[str, Any]:
    """获取指定 provider 的配置节点。"""
    return _load_config().get("providers", {}).get(provider, {})


def _get_strategy() -> str:
    strategy = get_model_router_config().get("strategy", "auto")
    if strategy in ("cheapest", "fastest", "smartest", "auto"):
        return strategy
    return "auto"


def _load_scoring_config() -> dict[str, Any]:
    scoring = get_model_router_config().get("scoring", {})
    merged = dict(_DEFAULT_SCORING)
    merged.update({k: v for k, v in scoring.items() if k in _DEFAULT_SCORING})
    return merged


def _load_moa_preset(preset_name: str) -> Optional[dict]:
    cfg = _load_config()
    moa_cfg = cfg.get("moa", {})
    presets = moa_cfg.get("presets", {})
    preset = presets.get(preset_name, {})
    if not preset:
        logger.warning("Model Router: MoA preset '%s' not found in config.yaml", preset_name)
    return preset or None


