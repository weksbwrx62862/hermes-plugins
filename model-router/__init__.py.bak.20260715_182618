def _cleanup_stale_routing():
    now = time.time()
    if not _ROUTER_STATE.is_cleanup_due(now, _ROUTING_CLEANUP_INTERVAL):
        return
    _ROUTER_STATE.mark_cleanup(now)
    cleaned = _ROUTER_STATE.cleanup_decisions(now, _ROUTING_TTL)
    if cleaned:
        logger.debug("Model Router: cleaned %d expired routing entries", cleaned)


